{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fps-pvp-online3d",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
"run_worker_first": ["/websocket"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SERVER",
        "class_name": "GameServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameServer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
